NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SCANNER_INTERNAL_TOKEN=replace-with-another-long-random-secret
SCANNER_URL=http://scanner:8001
DATA_DIR=/data
UPLOAD_ROOT=/uploads
# For native (non-Docker) local runs, set UPLOAD_ROOT to an absolute writable path,
# e.g. C:\Users\you\api-ac-scanner\web\uploads — the source scan rejects any path
# outside this root for safety.
REPORT_TTL_HOURS=168
MAX_STORED_REPORTS=200
QUEUE_CAPACITY=50
SCAN_CONCURRENCY=2
MAX_SESSIONS=1000
LOCAL_MODE=true
LOCAL_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1,::1,demo-api
LOCAL_ALLOWED_PORTS=80,443,3000,4000,4100,5000,8000,8080,8443
REMOTE_SAFE_MUTATION_ENABLED=false
REMOTE_SAFE_MUTATION_ALLOWED_ORIGINS=

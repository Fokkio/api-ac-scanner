<%- include('partials/header', { title: 'รายงานผลสแกน' }) %>
<%
  const kindLabels = { quick: 'สแกนด่วน', deep: 'สแกนสิทธิ์แบบละเอียด', discovery: 'ค้นหา Endpoint', source: 'สแกนซอร์สโค้ด', correlation: 'เชื่อมโยงหลักฐาน', mutation: 'ทดสอบการเปลี่ยนข้อมูล', workflow: 'เวิร์กโฟลว์' };
  const statusLabels = { queued: 'อยู่ในคิว', running: 'กำลังทำงาน', done: 'เสร็จแล้ว', error: 'ผิดพลาด' };
  const stateLabels = { verified: 'ยืนยันว่าขัดกับ Policy', detected: 'ตรวจพบ', suspected: 'น่าสงสัย', 'needs-verification': 'ต้องตรวจยืนยัน', passed: 'ผ่าน', 'not-tested': 'ไม่ได้ทดสอบ', error: 'ผิดพลาด' };
  const accessLabels = { allow: 'อนุญาต', deny: 'ปฏิเสธ', unknown: 'ไม่ทราบ' };
%>
<main id="main-content" class="report-page" data-report-id="<%= scan.id %>" data-report-status="<%= scan.status %>">
  <header class="report-header">
    <div>
      <span class="kind-chip"><%= kindLabels[scan.kind] || scan.kind %> (<%= scan.kind %>)</span>
      <h1><%= scan.target %></h1>
      <p>สร้างเมื่อ <%= new Date(scan.createdAt).toLocaleString('th-TH') %> / หมดอายุ <%= new Date(scan.expiresAt).toLocaleString('th-TH') %></p>
    </div>
    <div class="report-state">
      <strong id="scan-status"><%= statusLabels[scan.status] || scan.status %> (<%= scan.status %>)</strong>
      <span id="scan-stage"><%= scan.stage %></span>
      <% if (scan.status === 'done' || scan.status === 'error') { %>
        <span><a href="/reports/<%= scan.id %>/export.html">ดาวน์โหลด HTML</a> · <a href="/reports/<%= scan.id %>/export.pdf">ดาวน์โหลด PDF</a></span>
      <% } %>
    </div>
  </header>

  <% if (scan.status === 'queued' || scan.status === 'running') { %>
    <section class="panel progress-panel" aria-live="polite">
      <h2>กำลังวิเคราะห์</h2>
      <progress id="scan-progress" max="100" value="<%= scan.progress %>"><%= scan.progress %>%</progress>
      <p>หน้านี้อัปเดตอัตโนมัติ และจะไม่บันทึก credential ที่ให้มาไว้ในรายงาน</p>
    </section>
  <% } %>

  <% if (scan.status === 'error') { %>
    <section class="error-card">
      <h2>การสแกนไม่สำเร็จ — ระบบไม่ได้บันทึกผลว่า “ผ่าน”</h2>
      <p><%= scan.errorMessage %></p>
      <code><%= scan.errorCode %></code>
    </section>
  <% } %>

  <% if (scan.status === 'done') { %>
    <% if (scan.matrix && scan.matrix.length > 0) { %>
      <section class="panel">
        <div class="eyebrow">ตารางเปรียบเทียบสิทธิ์</div>
        <h2>สิทธิ์ที่คาดหวังเทียบกับผลจริง</h2>
        <p class="muted">V3.2 ใช้ Authorization Policy ที่คุณระบุไว้อย่างชัดเจนสำหรับงานสแกนนี้</p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Endpoint</th><th>Identity</th><th>Role / Tenant</th><th>ผลที่คาด</th><th>ผลจริง</th><th>ตรงกับ Policy</th></tr></thead>
            <tbody>
              <% scan.matrix.forEach(function(row) { %>
                <tr>
                  <td><code><%= row.method %> <%= row.path %></code></td>
                  <td><%= row.identity %></td>
                  <td><%= row.role || '-' %> / <%= row.tenant || '-' %></td>
                  <td><%= accessLabels[row.expected] || row.expected %> (<%= row.expected %>)</td>
                  <td><%= accessLabels[row.actual] || row.actual %> (<%= row.actualStatus %>)</td>
                  <td><span class="status-chip <%= row.skippedAfterPriorFailure ? 'status-not-tested' : row.matchesExpectation ? 'status-passed' : 'status-suspected' %>"><%= row.skippedAfterPriorFailure ? 'ข้าม' : row.matchesExpectation ? 'ตรง' : 'ไม่ตรง' %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
    <% if (scan.endpoints && scan.endpoints.length > 0) { %>
      <section class="panel">
        <div class="page-heading compact-heading">
          <div>
            <div class="eyebrow">รายการ Endpoint</div>
            <h2>ค้นพบ <%= scan.endpoints.length %> Endpoint</h2>
          </div>
          <a class="button-link" href="/dashboard?inventory=<%= scan.id %>">นำรายการไปใช้ในสแกนแบบละเอียด</a>
        </div>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Method</th><th>Path</th><th>ประเภทที่คาด</th><th>แหล่งข้อมูล</th><th>ความมั่นใจ</th></tr></thead>
            <tbody>
              <% scan.endpoints.forEach(function(endpoint) { %>
                <tr>
                  <td><code><%= endpoint.method %></code></td>
                  <td><code><%= endpoint.path %></code></td>
                  <td><%= endpoint.candidateType %></td>
                  <td><%= endpoint.sourceType %> / <%= endpoint.sourceFile %><%= endpoint.line ? ':' + endpoint.line : '' %></td>
                  <td><%= endpoint.confidence %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
    <section class="summary-grid">
      <% ['verified', 'detected', 'suspected', 'needs-verification', 'passed', 'not-tested', 'error'].forEach(function(state) { %>
        <article>
          <strong><%= scan.findings.filter(function(finding) { return finding.state === state; }).length %></strong>
          <span><%= stateLabels[state] || state.replace('-', ' ') %></span>
        </article>
      <% }); %>
    </section>

    <details class="panel">
      <summary><strong>คำอธิบายสถานะและคำศัพท์ในรายงาน</strong></summary>
      <p><strong>Verified:</strong> ผลจริงขัดกับ Policy ที่คุณระบุ จึงมีหลักฐานให้ตรวจสอบทันที แต่ยังต้องยืนยันผลกระทบทางธุรกิจ</p>
      <p><strong>Detected / Suspected:</strong> ตรวจพบสัญญาณหรือรูปแบบที่น่าสงสัย ยังไม่ถือเป็นช่องโหว่ที่ยืนยันแล้ว</p>
      <p><strong>Needs verification:</strong> ต้องใช้ข้อมูลเรื่องเจ้าของ Object, บทบาท หรือ Tenant เพิ่มเติมก่อนสรุป</p>
      <p><strong>BOLA:</strong> ผู้ใช้เข้าถึง Object ของผู้อื่นได้ · <strong>BFLA:</strong> ผู้ใช้เรียก Function ที่บทบาทตนไม่ควรใช้ได้</p>
      <p><strong>Property authorization:</strong> ผู้ใช้เห็นหรือแก้ field ที่ไม่ควรมีสิทธิ์ · <strong>Enumeration:</strong> response เปิดเผยว่าทรัพยากรหรือบัญชีใดมีอยู่</p>
    </details>

    <% scan.warnings.forEach(function(warning) { %>
      <div class="warning-card"><%= warning %></div>
    <% }); %>

    <section class="findings">
      <% if (scan.findings.length === 0) { %>
        <div class="empty-card">ไม่พบรายการผิดปกติ แต่ต้องตรวจคำเตือนและขอบเขตที่สแกนก่อนสรุปว่าระบบปลอดภัย</div>
      <% } %>
      <% scan.findings.forEach(function(finding) { %>
        <details class="finding-card" <%= finding.state === 'detected' || finding.state === 'suspected' ? 'open' : '' %>>
          <summary>
            <span class="status-chip status-<%= finding.state %>"><%= stateLabels[finding.state] || finding.state.replace('-', ' ') %></span>
            <span><%= finding.title %></span>
            <small><%= finding.owaspId %> / ความมั่นใจ <%= finding.confidence %></small>
          </summary>
          <div class="finding-body">
            <p><%= finding.description %></p>
            <% if (finding.location) { %><code><%= finding.location %></code><% } %>
            <h3>หลักฐาน (Evidence)</h3>
            <dl>
              <% Object.entries(finding.evidence).forEach(function(entry) { %>
                <dt><%= entry[0] %></dt><dd><%= entry[1] %></dd>
              <% }); %>
            </dl>
            <h3>วิธีตรวจยืนยันที่แนะนำ</h3>
            <p><%= finding.recommendation %></p>
          </div>
        </details>
      <% }); %>
    </section>
  <% } %>
</main>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Scan report' }) %>
<main id="main-content" class="report-page" data-report-id="<%= scan.id %>" data-report-status="<%= scan.status %>">
  <header class="report-header">
    <div>
      <span class="kind-chip"><%= scan.kind %> scan</span>
      <h1><%= scan.target %></h1>
      <p>Created <%= new Date(scan.createdAt).toLocaleString() %> / Expires <%= new Date(scan.expiresAt).toLocaleString() %></p>
    </div>
    <div class="report-state">
      <strong id="scan-status"><%= scan.status %></strong>
      <span id="scan-stage"><%= scan.stage %></span>
      <% if (scan.status === 'done' || scan.status === 'error') { %>
        <span><a href="/reports/<%= scan.id %>/export.html">Download HTML</a> · <a href="/reports/<%= scan.id %>/export.pdf">Download PDF</a></span>
      <% } %>
    </div>
  </header>

  <% if (scan.status === 'queued' || scan.status === 'running') { %>
    <section class="panel progress-panel" aria-live="polite">
      <h2>Analysis in progress</h2>
      <progress id="scan-progress" max="100" value="<%= scan.progress %>"><%= scan.progress %>%</progress>
      <p>The report updates automatically. Credentials, if supplied, are not stored in this report.</p>
    </section>
  <% } %>

  <% if (scan.status === 'error') { %>
    <section class="error-card">
      <h2>Scan failed - no clean result was recorded</h2>
      <p><%= scan.errorMessage %></p>
      <code><%= scan.errorCode %></code>
    </section>
  <% } %>

  <% if (scan.status === 'done') { %>
    <% if (scan.matrix && scan.matrix.length > 0) { %>
      <section class="panel">
        <div class="eyebrow">AUTHORIZATION MATRIX</div>
        <h2>Expected vs actual access</h2>
        <p class="muted">V3.2 uses the complete explicit authorization policy supplied for this scan.</p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Endpoint</th><th>Identity</th><th>Role / tenant</th><th>Expected</th><th>Actual</th><th>Match</th></tr></thead>
            <tbody>
              <% scan.matrix.forEach(function(row) { %>
                <tr>
                  <td><code><%= row.method %> <%= row.path %></code></td>
                  <td><%= row.identity %></td>
                  <td><%= row.role || '-' %> / <%= row.tenant || '-' %></td>
                  <td><%= row.expected %></td>
                  <td><%= row.actual %> (<%= row.actualStatus %>)</td>
                  <td><span class="status-chip <%= row.skippedAfterPriorFailure ? 'status-not-tested' : row.matchesExpectation ? 'status-passed' : 'status-suspected' %>"><%= row.skippedAfterPriorFailure ? 'skipped' : row.matchesExpectation ? 'match' : 'mismatch' %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
    <% if (scan.endpoints && scan.endpoints.length > 0) { %>
      <section class="panel">
        <div class="page-heading compact-heading">
          <div>
            <div class="eyebrow">ENDPOINT INVENTORY</div>
            <h2><%= scan.endpoints.length %> endpoints discovered</h2>
          </div>
          <a class="button-link" href="/dashboard?inventory=<%= scan.id %>">Use candidates in deep scan</a>
        </div>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Method</th><th>Path</th><th>Candidate</th><th>Source</th><th>Confidence</th></tr></thead>
            <tbody>
              <% scan.endpoints.forEach(function(endpoint) { %>
                <tr>
                  <td><code><%= endpoint.method %></code></td>
                  <td><code><%= endpoint.path %></code></td>
                  <td><%= endpoint.candidateType %></td>
                  <td><%= endpoint.sourceType %> / <%= endpoint.sourceFile %><%= endpoint.line ? ':' + endpoint.line : '' %></td>
                  <td><%= endpoint.confidence %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
    <section class="summary-grid">
      <% ['verified', 'detected', 'suspected', 'needs-verification', 'passed', 'not-tested', 'error'].forEach(function(state) { %>
        <article>
          <strong><%= scan.findings.filter(function(finding) { return finding.state === state; }).length %></strong>
          <span><%= state.replace('-', ' ') %></span>
        </article>
      <% }); %>
    </section>

    <% scan.warnings.forEach(function(warning) { %>
      <div class="warning-card"><%= warning %></div>
    <% }); %>

    <section class="findings">
      <% if (scan.findings.length === 0) { %>
        <div class="empty-card">No findings were produced. Check the scan warnings and coverage before drawing conclusions.</div>
      <% } %>
      <% scan.findings.forEach(function(finding) { %>
        <details class="finding-card" <%= finding.state === 'detected' || finding.state === 'suspected' ? 'open' : '' %>>
          <summary>
            <span class="status-chip status-<%= finding.state %>"><%= finding.state.replace('-', ' ') %></span>
            <span><%= finding.title %></span>
            <small><%= finding.owaspId %> / <%= finding.confidence %> confidence</small>
          </summary>
          <div class="finding-body">
            <p><%= finding.description %></p>
            <% if (finding.location) { %><code><%= finding.location %></code><% } %>
            <h3>Evidence</h3>
            <dl>
              <% Object.entries(finding.evidence).forEach(function(entry) { %>
                <dt><%= entry[0] %></dt><dd><%= entry[1] %></dd>
              <% }); %>
            </dl>
            <h3>Recommended verification</h3>
            <p><%= finding.recommendation %></p>
          </div>
        </details>
      <% }); %>
    </section>
  <% } %>
</main>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'พื้นที่ตรวจสอบสิทธิ์' }) %>
<main id="main-content" class="workspace">
  <header class="page-heading">
    <div>
      <div class="eyebrow">แล็บตรวจสอบสิทธิ์บนเครื่อง</div>
      <h1>พื้นที่ตรวจสอบการควบคุมสิทธิ์</h1>
      <p><%= localMode ? 'เปิดโหมด Local แล้ว ระบบจะเชื่อถือเฉพาะ host บนเครื่องที่อยู่ใน allowlist โดยอัตโนมัติ' : 'เป้าหมายภายนอกต้องยืนยันความเป็นเจ้าของแบบ exact origin' %></p>
    </div>
  </header>

  <section class="panel">
    <h2>1. เพิ่ม API บนเครื่องหรือระบบ Staging</h2>
    <form class="inline-form" action="/assets" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label class="sr-only" for="origin">Origin แบบตรงตัว</label>
      <input id="origin" name="origin" type="url" required placeholder="http://host.docker.internal:4100" />
      <button type="submit">เพิ่ม API</button>
    </form>
    <% if (localMode) { %>
      <form class="inline-form" action="/assets" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="origin" value="http://host.docker.internal:4100" />
        <span class="muted">เปิด Demo Lab จากเมนู 9 ก่อน แล้วเพิ่มเป้าหมายตัวอย่างได้ทันที</span>
        <button class="secondary-button" type="submit">เพิ่ม Demo API อัตโนมัติ</button>
      </form>
    <% } %>
  </section>

  <section class="asset-list" aria-label="API ที่ตั้งค่าไว้">
    <% if (assets.length === 0) { %>
      <div class="empty-card">ยังไม่มี API กรุณาเพิ่ม local origin ที่อยู่ใน allowlist หรือ HTTPS origin แบบตรงตัวที่คุณควบคุม</div>
    <% } %>
    <% assets.forEach(function(asset) { %>
      <article class="asset-card">
        <div>
          <span class="status-chip <%= asset.isVerified ? 'status-passed' : 'status-needs-verification' %>">
            <%= asset.isVerified ? 'ยืนยันแล้ว (Verified)' : 'รอการยืนยัน' %>
          </span>
          <h3><%= asset.origin %></h3>
          <% const isLocalAsset = localAssetIds.includes(asset.id); %>
          <% if (asset.verificationMethod || isLocalAsset) { %>
            <p class="muted">วิธียืนยัน: <code><%= isLocalAsset ? 'local-allowlist' : asset.verificationMethod %></code></p>
          <% } %>
          <% if (!isLocalAsset) { %>
            <p><%= asset.isVerified ? 'ต้องคงหลักฐาน exact-origin อย่างน้อยหนึ่งแบบไว้ระหว่างการทดสอบที่เปลี่ยนข้อมูล:' : 'เลือกวิธียืนยัน exact-origin หนึ่งแบบ:' %></p>
            <code><%= asset.origin %>/.well-known/api-ac-scanner-verification.txt</code>
            <code>api-ac-scanner-v2.6-verification=<%= asset.challenge %></code>
            <code>Header: X-API-AC-Scanner-Verification: <%= asset.challenge %></code>
            <code>DNS TXT: _api-ac-scanner.<%= new URL(asset.origin).hostname %> = <%= asset.challenge %></code>
          <% } %>
        </div>
        <% if (!isLocalAsset) { %>
          <form action="/assets/<%= asset.id %>/verify" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <select name="verificationMethod" aria-label="วิธียืนยันความเป็นเจ้าของ">
              <option value="file">ไฟล์ Well-known</option>
              <option value="header">HTTP Header</option>
              <option value="dns">DNS TXT</option>
            </select>
            <button class="secondary-button" type="submit"><%= asset.isVerified ? 'ยืนยันอีกครั้ง' : 'ยืนยันตอนนี้' %></button>
          </form>
        <% } %>
      </article>
    <% }); %>
  </section>

  <section class="panel">
    <h2>2. สร้างตารางเปรียบเทียบสิทธิ์ (Authorization Matrix)</h2>
    <p class="muted">Token จะอยู่เฉพาะในหน่วยความจำของงานที่กำลังรัน และไม่ถูกบันทึกลงรายงานหรือดิสก์</p>
    <% if (inventory && inventory.length > 0) { %>
      <div class="warning-card">
        โหลด Endpoint ที่ค้นพบแล้ว <%= inventory.length %> รายการ ระบบเติมให้เฉพาะ GET path ที่เป็นค่าจริง
        กรุณาแทน placeholder เช่น <code>{id}</code> หรือ <code>:id</code> ด้วย object สำหรับทดสอบโดยเฉพาะ
      </div>
    <% } %>
    <form class="stack-form" action="/scans/deep" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>API ที่ยืนยันแล้ว
        <select name="assetId" required>
          <option value="">เลือก API</option>
          <% assets.filter(function(asset) { return asset.isVerified; }).forEach(function(asset) { %>
            <option value="<%= asset.id %>"><%= asset.origin %></option>
          <% }); %>
        </select>
      </label>
      <div class="two-column">
        <label>Path ของ Object
          <textarea name="objectPaths" required rows="5" placeholder="/api/orders/123&#10;/api/documents/abc"><%= suggestedObjectPaths.join('\n') %></textarea>
          <small>Object ของ owner/tenant ที่รู้จัก ใช้เฉพาะ relative path สูงสุด 5 รายการ</small>
        </label>
        <label>Path ของ Admin/Function
          <textarea name="adminPaths" required rows="5" placeholder="/api/admin/users&#10;/api/admin/reports"><%= suggestedFunctionPaths.join('\n') %></textarea>
          <small>Function ที่คาดว่าต้องใช้ token ของโปรไฟล์แรก สูงสุด 5 รายการ</small>
        </label>
      </div>
      <label>Policy การอนุญาตที่กำหนดชัดเจน (JSON)
        <textarea name="authorizationPolicy" required rows="12" maxlength="20000"
          placeholder='[{"method":"GET","path":"/api/orders/1","identity":"Alice","expected":"allow"},{"method":"GET","path":"/api/orders/1","identity":"Bob","expected":"deny"},{"method":"GET","path":"/api/orders/1","identity":"Anonymous","expected":"deny"}]'></textarea>
        <small>ต้องมี rule ของทุกโปรไฟล์และ Anonymous สำหรับทุก object/function path โดยชื่อ identity ต้องตรงกับชื่อโปรไฟล์ทุกตัวอักษร</small>
      </label>
      <div class="two-column">
        <label>Path ที่ทราบว่ามีอยู่ สำหรับทดสอบ Enumeration (ไม่บังคับ)
          <textarea name="enumerationExistingPaths" rows="4" placeholder="/api/users/alice"></textarea>
          <small>แต่ละบรรทัดต้องจับคู่กับรายการ Path ที่ไม่มีอยู่ สูงสุด 5 คู่</small>
        </label>
        <label>Path ที่ทราบว่าไม่มีอยู่ สำหรับทดสอบ Enumeration (ไม่บังคับ)
          <textarea name="enumerationMissingPaths" rows="4" placeholder="/api/users/definitely-missing"></textarea>
          <small>ลำดับต้องตรงกับรายการ Path ที่มีอยู่</small>
        </label>
      </div>
      <div class="two-column">
        <% ['primary', 'alternate'].forEach(function(prefix, index) { %>
          <fieldset class="identity-card">
            <legend><%= index === 0 ? 'โปรไฟล์หลัก / เจ้าของข้อมูล' : 'โปรไฟล์เปรียบเทียบ / สิทธิ์ต่ำกว่า' %></legend>
            <label>ชื่อโปรไฟล์<input name="<%= prefix %>Label" required maxlength="64" placeholder="<%= index === 0 ? 'Alice owner' : 'Bob alternate' %>" /></label>
            <label>บทบาทที่คาดหวัง<input name="<%= prefix %>Role" maxlength="64" placeholder="user หรือ admin" /></label>
            <label>Tenant / ขอบเขต<input name="<%= prefix %>Tenant" maxlength="64" placeholder="tenant-a" /></label>
            <label>ประเภท Authentication
              <select name="<%= prefix %>AuthType" required>
                <option value="bearer">Bearer token</option>
                <option value="basic">HTTP Basic</option>
                <option value="cookie">Cookie header</option>
                <option value="api-key">API key header</option>
                <option value="custom-headers">Custom headers JSON</option>
              </select>
            </label>
            <label>ชื่อ Header ของ API key (ใช้เฉพาะ API key)
              <input name="<%= prefix %>HeaderName" maxlength="128" placeholder="x-api-key" />
            </label>
            <label>Credential / Custom Header แบบ JSON
              <textarea name="<%= prefix %>Credential" required maxlength="8192" rows="3" autocomplete="off"
                placeholder='<%= index === 0 ? "owner-local-token-1234567890" : "alternate-local-token-1234567890" %>'></textarea>
            </label>
          </fieldset>
        <% }); %>
      </div>
      <button type="submit">เริ่มสแกนเปรียบเทียบสิทธิ์</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>

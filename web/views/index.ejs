<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>API Access-Control Scanner</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <span class="logo">⛨</span>
      <span class="brand-text">api-<b>ac</b>-scanner</span>
    </div>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/scan/source">Scan Source</a>
      <a href="/scan/domain">Scan Domain</a>
    </nav>
  </header>

  <main class="container">
    <section class="hero">
      <h1>API Authorization &amp; Access-Control Scanner</h1>
      <p class="sub">
        Find <b>BOLA</b>, <b>BFLA</b>, <b>Mass Assignment</b> and other access-control
        flaws in your APIs — then fix them. Built for penetration testers.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/scan/domain">Scan a live domain</a>
        <a class="btn" href="/scan/source">Scan source code</a>
      </div>
    </section>

    <section class="recent">
      <h2>Recent scans</h2>
      <% if (scans.length === 0) { %>
        <p class="muted">No scans yet. Run one above to populate the dashboard.</p>
      <% } else { %>
        <div class="scan-grid">
          <% scans.forEach(function(s){ const c = summarize(s.findings); %>
            <a class="scan-card" href="/scan/<%= s.id %>">
              <div class="scan-card-head">
                <span class="scan-kind scan-kind-<%= s.kind %>"><%= s.kind %></span>
                <span class="scan-target"><%= s.target %></span>
              </div>
              <div class="sev-pills">
                <% ['Critical','High','Medium','Low'].forEach(function(k){ if(c[k]){ %>
                  <span class="pill pill-<%= k %>"><%= k %> <%= c[k] %></span>
                <% }}) %>
                <% if (!c.Critical && !c.High && !c.Medium && !c.Low) { %>
                  <span class="pill pill-none">no issues</span>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="foot">
    <span>Local-only · OWASP API Top 10 risk rating + CVSS</span>
  </footer>
  <script src="/app.js"></script>
</body>
</html>

<%- include('partials/header', { title: 'Source scan' }) %>
<main id="main-content" class="narrow-page">
  <section class="panel">
    <div class="eyebrow">LOCAL STATIC SCAN</div>
    <h1>Scan source files</h1>
    <p>Upload up to 25 supported files. Each file is capped at 1 MiB and the temporary copy is removed after scanning.</p>
    <form class="stack-form" action="/scans/source" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Source files or directory
        <input name="sources" type="file" multiple required webkitdirectory directory
          accept=".js,.jsx,.ts,.tsx,.py,.php,.java" />
      </label>
      <button type="submit">Run source scan</button>
    </form>
    <p class="muted">V3.2 reports guidance only. Automated code modification is intentionally disabled.</p>
  </section>
</main>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'ค้นหา Endpoint ของ API' }) %>
<main id="main-content" class="narrow-page">
  <section class="page-heading">
    <div>
      <div class="eyebrow">ค้นหาจากหลักฐานที่ให้มา</div>
      <h1>สร้างรายการ Endpoint ของ API</h1>
      <p>นำเข้า OpenAPI/Swagger, HAR, Postman Collection หรือซอร์สไฟล์ที่รองรับ โดย V3.2 จะไม่ brute-force หรือ crawl route ที่ไม่รู้จัก</p>
    </div>
  </section>
  <section class="panel">
    <form class="stack-form" action="/scans/discovery" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>API ที่ยืนยันแล้ว
        <select name="assetId" required>
          <option value="">เลือก API</option>
          <% assets.forEach(function(asset) { %>
            <option value="<%= asset.id %>"><%= asset.origin %></option>
          <% }); %>
        </select>
      </label>
      <label>ไฟล์หลักฐานสำหรับค้นหา Endpoint
        <input name="artifacts" type="file" required multiple
          accept=".json,.yaml,.yml,.har,.js,.jsx,.ts,.tsx,.py,.php,.java" />
        <small>สูงสุด 25 ไฟล์ ไฟล์ละไม่เกิน 1 MiB และระบบจะลบไฟล์หลังงานเสร็จ</small>
      </label>
      <button type="submit">ค้นหา Endpoint</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>

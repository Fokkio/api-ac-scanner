<%- include('partials/header', { title: 'Owner login' }) %>
<main id="main-content" class="narrow-page">
  <section class="panel auth-panel">
    <div class="eyebrow">OWNER WORKSPACE</div>
    <h1>Sign in</h1>
    <p>Deep and source scans are restricted because they use private test context or uploaded code.</p>
    <form class="stack-form" action="/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Username<input name="username" required autocomplete="username" /></label>
      <label>Password<input name="password" type="password" required autocomplete="current-password" /></label>
      <button type="submit">Continue</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
